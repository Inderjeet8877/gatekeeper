# Gatekeeper API base URL (must include /api/v1). Copy to .env and edit.
#
# - iOS simulator / web on the same PC:  http://localhost:4000/api/v1   (default if unset)
# - Android emulator:                    http://10.0.2.2:4000/api/v1
# - Physical phone with Expo Go:         http://<your PC's LAN IP>:4000/api/v1   e.g. http://192.168.1.20:4000/api/v1
#   (phone and PC on the same Wi-Fi; find the IP with `ipconfig` on Windows. Allow port 4000 in the firewall.)
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

# Admin web console URL shown to admin-only accounts (default http://localhost:8080).
EXPO_PUBLIC_WEB_URL=http://localhost:8080
